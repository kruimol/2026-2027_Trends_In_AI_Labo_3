# Kopieer dit bestand naar .env en pas aan indien nodig. Alles is optioneel.
# De persoonlijke toegangssleutels zijn GEEN .env-waarde: die worden per gebruiker
# aangemaakt (maak_gebruiker.py) en bewaard in de SQLite-databank.

# Adres waarop de server luistert.
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Pad naar de SQLite-databank (laat leeg voor het standaardbestand context.sqlite).
MCP_DB_PATH=
