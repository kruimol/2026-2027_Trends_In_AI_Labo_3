# Kopieer dit bestand naar .env en vul in wat je nodig hebt.
# Zet NOOIT echte wachtwoorden of sleutels in .env.example of in de code.

# --- MCP-server ---
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Pad naar de SQLite-databank (laat leeg voor het standaardbestand trends_ai.sqlite).
MCP_DB_PATH=

# --- WebUntis (GEDEELDE login) ---
# Server zonder https://, bv. mese.webuntis.com
UNTIS_SERVER=
UNTIS_SCHOOL=
UNTIS_USER=
# Ofwel wachtwoord, ofwel geheime sleutel (TOTP). Laat de andere leeg.
UNTIS_PASSWORD=
UNTIS_SECRET=
# Standaardklas als de gebruiker er zelf geen heeft laten onthouden (bv. 3itai).
# Moet in config.py staan. Laat leeg om het persoonlijke studentenrooster te proberen.
UNTIS_KLAS=

# De Digitap ICS-URL is PER GEBRUIKER en staat niet hier, maar in de databank
# (stel ze in met beheer.py). Zie README.
