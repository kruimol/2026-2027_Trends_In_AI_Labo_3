# Kopieer dit bestand naar .env en vul je eigen gegevens in.
# Zet NOOIT een echt wachtwoord of sleutel in .env.example of in de code.

# Server zonder https://, bv. mese.webuntis.com (zie README hoe je die vindt).
UNTIS_SERVER=
# De exacte schoolnaam zoals WebUntis die kent (zie README).
UNTIS_SCHOOL=
# Je studentengebruikersnaam.
UNTIS_USER=

# Welke klas-rooster we lezen (naam moet in config.py staan, bv. 3itai).
# Nodig omdat veel scholen het persoonlijke studentenrooster blokkeren (-8509).
# Laat leeg om toch je persoonlijke rooster te proberen.
UNTIS_KLAS=

# Route 1: wachtwoord. Laat leeg als je met de geheime sleutel inlogt.
UNTIS_PASSWORD=
# Route 2: geheime sleutel uit je WebUntis-profiel (achter de QR-code).
# Als deze is ingevuld, wordt die route gebruikt (handig bij Microsoft-SSO).
UNTIS_SECRET=
